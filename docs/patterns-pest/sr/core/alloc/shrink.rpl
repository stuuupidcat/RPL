pattern core-alloc-Allocator-shrink

patt {
    use core::alloc::Layout;

    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "Allocator::shrink", requirement = "new_layout.size() <= old_layout.size()")]
    allocator_shrink_new_size_too_large = {
        unsafe? fn _(..) -> _ {
            let $old_layout: Layout = _;
            let $new_layout: Layout = _;
            'use:
            _ = core::alloc::Allocator::shrink(_, _, move $old_layout, move $new_layout);
        } where {
            layout_size_gt('use, $new_layout, $old_layout)
        }
    }
}

diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires {$requirement}",
        note         = "the new allocation size is proven larger than the old allocation size",
        help         = "use a new layout whose size does not exceed the old layout size",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
