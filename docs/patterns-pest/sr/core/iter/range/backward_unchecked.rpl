pattern core-iter-range-Step-backward_unchecked

patt {
    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "Step::backward_unchecked", requirement = "start - count does not overflow")]
    step_backward_unchecked_overflow_u8 = unsafe? fn _(..) -> _ {
        let $start: u8 = _;
        let $count: usize = _;
        'use:
        let $result: u8 = core::iter::range::Step::backward_unchecked(move $start, move $count);
    } where {
        sub_lt_const('use, $start, $count, 0u8)
    }

    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "Step::backward_unchecked", requirement = "start - count does not overflow")]
    step_backward_unchecked_overflow_u16 = unsafe? fn _(..) -> _ {
