diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires that {$requirement}",
        note         = "the step is proven to overflow",
        help         = "use `Step::backward_checked` or validate the number of remaining steps before calling this function",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
