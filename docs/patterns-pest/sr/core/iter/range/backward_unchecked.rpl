    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "Step::backward_unchecked", requirement = "skipping the surrogate range does not go below 0")]
    step_backward_unchecked_overflow_char_surrogate_skip[$T: type where is_char(self)] = unsafe? fn _(..) -> _ {
        let $start: $T = _;
        let $count: usize = _;
        'use:
        let $result: $T = core::iter::range::Step::backward_unchecked(move $start, move $count);
    } where {
        !sub_lt_const('use, $start, $count, 0) &&
        gt_const('use, $start, 0xDFFF) &&
        sub_lt_const('use, $start, $count, 0x800)
