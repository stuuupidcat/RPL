        'use:
        let $result: i64 = core::iter::range::Step::backward_unchecked(move $start, move $count);
    } where {
        sub_lt_const('use, $start, $count, 9223372036854775808i64)
    }

    #[diag = "unsafe_numeric_precondition"]
