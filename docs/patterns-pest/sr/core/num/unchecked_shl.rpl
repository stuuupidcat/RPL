}

diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires that {$requirement}",
        note         = "the shift amount is proven to be out of bounds",
        help         = "validate the shift amount before calling this unsafe function or use the safe checked API",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
