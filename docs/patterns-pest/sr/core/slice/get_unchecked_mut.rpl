pattern core-slice-get_unchecked_mut

patt {
    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "slice::get_unchecked_mut", requirement = "index < len")]
    slice_get_unchecked_mut_out_of_bounds[$T: type] = {
        unsafe fn $get_unchecked_mut(_: &mut [$T], _: _) -> _;

        unsafe? fn _(..) -> _ {
            'slice:
            let $slice: &mut [$T] = _;
            'index:
            let $index: usize = _;
            'use:
            let $value: &mut $T = $get_unchecked_mut(move $slice, move $index);
        } where {
            index_ge_len('use, $slice, $index)
        }
    }
}

diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires {$requirement}",
        note         = "this value violates the numeric precondition",
        help         = "validate the value before calling this unsafe function or use the safe checked API",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
