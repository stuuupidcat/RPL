pattern core-slice-split_at_mut_unchecked

patt {
    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "slice::split_at_mut_unchecked", requirement = "mid <= len")]
    slice_split_at_mut_unchecked_out_of_bounds[$T: type] = {
        unsafe fn $split_at_mut_unchecked(_: &mut [$T], _: usize) -> (&mut [$T], &mut [$T]);

        unsafe? fn _(..) -> _ {
            'slice:
            let $slice: &mut [$T] = _;
            'mid:
            let $mid: usize = _;
            'use:
            let $parts: (&mut [$T], &mut [$T]) = $split_at_mut_unchecked(move $slice, move $mid);
        } where {
            index_gt_len('use, $slice, $mid)
        }
    }
}

diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires {$requirement}",
        note         = "this value violates the numeric precondition",
        help         = "validate the value before calling this unsafe function or use the safe checked API",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
