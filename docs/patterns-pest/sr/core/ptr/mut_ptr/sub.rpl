pattern core-ptr-mut_ptr-sub

patt {
    #[diag = "unsafe_numeric_precondition"]
    #[const(operation = "*mut T::sub", requirement = "count * size_of::<T>() fits in isize")]
    mut_ptr_sub_scaled_count_out_of_range[$T: type] = {
        unsafe? fn _(..) -> _ {
            let $ptr: *mut $T = _;
            let $count: usize = _;
            'use:
            let $result: *mut $T = mut_ptr::sub(move $ptr, move $count);
        } where {
            size_mul_gt_const('use, $count, $T, 9223372036854775807isize)
        }
    }
}

diag {
    unsafe_numeric_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires {$requirement}",
        note         = "the scaled pointer offset is proven outside the isize range",
        help         = "use a count whose byte offset fits in isize",
        name         = "unsafe_numeric_precondition",
        level        = "warn",
    }
}
