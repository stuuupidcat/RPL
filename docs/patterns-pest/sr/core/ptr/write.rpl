pattern core-ptr-write

patt {
    #[diag = "unsafe_null_precondition"]
    #[const(operation = "ptr::write")]
    null_ptr_write[$T: type] = unsafe? fn _(..) -> _ {
        'ptr:
        let $ptr: *mut $T = _;
        'use:
        _ = core::ptr::write::<_>(copy $ptr, _);
    } where {
        is_null('use, $ptr)
    }
}

diag {
    unsafe_null_precondition = {
        primary(use) = "this unsafe operation violates a safety property: `{$operation}` requires a non-null pointer, but the pointer is proven null",
        note(ptr)    = "`{$ptr}` is known to be null at this program point",
        help         = "check the pointer for null or document and enforce a precondition that guarantees it is non-null before this unsafe operation",
        name         = "unsafe_null_precondition",
        level        = "warn",
    }
}
